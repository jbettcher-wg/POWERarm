diff --git i/Source/Tools/FEXInterpreter/FEXInterpreter.cpp w/Source/Tools/FEXInterpreter/FEXInterpreter.cpp
index 54d315283..7fd779222 100644
--- i/Source/Tools/FEXInterpreter/FEXInterpreter.cpp
+++ w/Source/Tools/FEXInterpreter/FEXInterpreter.cpp
@@ -528,6 +528,10 @@ int main(int argc, char** argv, char** const envp) {
 
   FEXCore::Telemetry::Initialize();
 
+  // Whether ProgramPath is a guest path inside the RootFS (its prefix stripped
+  // below), as opposed to a host path. The realpath() further down must know,
+  // or it resolves a guest path against the host filesystem.
+  bool ProgramInRootFS = false;
   if (!LDPath().empty() && Program.ProgramPath.starts_with(LDPath())) {
     // From this point on, ProgramPath needs to not have the LDPath prefixed on to it.
     auto RootFSLength = LDPath().size();
@@ -538,6 +542,7 @@ int main(int argc, char** argv, char** const envp) {
     }
 
     Program.ProgramPath.erase(0, RootFSLength);
+    ProgramInRootFS = true;
   }
 
   bool ProgramExists = InterpreterHandler(&Program.ProgramPath, LDPath(), &Args);
@@ -591,12 +596,40 @@ int main(int argc, char** argv, char** const envp) {
   } else {
     {
       char ExistsTempPath[PATH_MAX];
-      char* RealPath = realpath(Program.ProgramPath.c_str(), ExistsTempPath);
-      if (RealPath) {
-        FEXCore::Config::Set(FEXCore::Config::CONFIG_APP_FILENAME, fextl::string(RealPath));
+      fextl::string ResolvedPath {};
+      if (ProgramInRootFS) {
+        // ProgramPath is a guest path with the RootFS prefix already stripped.
+        // realpath() on it directly would follow the *host's* symlinks: a RootFS
+        // /usr/bin/python3 -> python3.12 came back as the host's
+        // /usr/bin/python3 -> python3.14, which /proc/self/exe then reported and
+        // ExecveHandler re-executed as a native binary. Resolve inside the RootFS
+        // and strip the prefix again. Compare against the RootFS's own realpath:
+        // the configured RootFS path may itself sit under a symlink
+        // (e.g. /home -> /mnt/arch/home).
+        char RootFSTempPath[PATH_MAX];
+        const fextl::string InRootFS = LDPath() + Program.ProgramPath;
+        const char* RealRootFS = realpath(LDPath().c_str(), RootFSTempPath);
+        const char* RealPath = realpath(InRootFS.c_str(), ExistsTempPath);
+        if (RealPath && RealRootFS) {
+          const std::string_view Resolved {RealPath};
+          const std::string_view Root {RealRootFS};
+          if (Resolved.size() > Root.size() && Resolved.starts_with(Root) && Resolved[Root.size()] == '/') {
+            ResolvedPath = fextl::string(Resolved.substr(Root.size()));
+          }
+        }
+      } else {
+        const char* RealPath = realpath(Program.ProgramPath.c_str(), ExistsTempPath);
+        if (RealPath) {
+          ResolvedPath = RealPath;
+        }
+      }
+
+      if (!ResolvedPath.empty()) {
+        FEXCore::Config::Set(FEXCore::Config::CONFIG_APP_FILENAME, ResolvedPath);
       } else {
         // Can happen when jumping in to pressure-vessel.
         // `/usr/lib/pressure-vessel/from-host/libexec/steam-runtime-tools-0/pv-adverb` can't get resolved.
+        // Also the fallback when a RootFS program resolves to somewhere outside the RootFS.
         FEXCore::Config::Set(FEXCore::Config::CONFIG_APP_FILENAME, Program.ProgramPath);
       }
     }
diff --git i/Source/Tools/LinuxEmulation/LinuxSyscalls/FileManagement.cpp w/Source/Tools/LinuxEmulation/LinuxSyscalls/FileManagement.cpp
index e1bbb0d24..b928d8251 100644
--- i/Source/Tools/LinuxEmulation/LinuxSyscalls/FileManagement.cpp
+++ w/Source/Tools/LinuxEmulation/LinuxSyscalls/FileManagement.cpp
@@ -1847,6 +1847,36 @@ uint64_t FileManager::Renameat2(int olddirfd, const char* oldpath, int newdirfd,
   // cross-boundary moves. Skip if flags asked for something we can't emulate
   // via copy (RENAME_EXCHANGE, RENAME_NOREPLACE with dest existing).
   if (Result == -1 && errno == EXDEV) {
+    // The degrade below copies bytes, so it is only valid for a regular file
+    // with no flags. Two cases it must refuse rather than attempt:
+    //
+    //   * A directory source. openat(O_RDONLY) on a directory SUCCEEDS, so
+    //     without this check the O_CREAT below creates a 0-byte regular file
+    //     at the destination (with the directory's mode, hence an exec bit)
+    //     and the first read() fails EISDIR -- leaving that file behind and
+    //     reporting an errno that describes none of it. `bun install` hits
+    //     exactly this: it extracts a package into a temp directory, renames
+    //     the directory into the cache, and fails with
+    //       error: moving "left-pad" to cache dir failed: EISDIR (rename())
+    //     leaving a 0-byte 'left-pad@1.3.0@@@1' in the cache directory.
+    //
+    //   * RENAME_EXCHANGE / RENAME_NOREPLACE. The comment below always said
+    //     these were skipped; nothing checked. An EXCHANGE degraded to copy is
+    //     not an exchange, and NOREPLACE degraded to O_CREAT|O_TRUNC is the
+    //     opposite of what the caller asked for.
+    //
+    // Leave EXDEV as the result in both cases: it is the truthful answer, and
+    // callers that care already handle it.
+    struct stat src_st;
+    bool refuse = (flags & (RENAME_EXCHANGE | RENAME_NOREPLACE)) != 0;
+    if (!refuse && ::fstatat(eff_olddirfd, eff_oldpath, &src_st, AT_SYMLINK_NOFOLLOW) == 0) {
+      refuse = !S_ISREG(src_st.st_mode);
+    }
+    if (refuse) {
+      errno = EXDEV;
+      return -1;
+    }
+
     int src_fd = ::openat(eff_olddirfd, eff_oldpath, O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
     if (src_fd == -1 && errno == ELOOP) {
       src_fd = ::openat(eff_olddirfd, eff_oldpath, O_RDONLY | O_CLOEXEC);
@@ -1884,6 +1914,12 @@ uint64_t FileManager::Renameat2(int olddirfd, const char* oldpath, int newdirfd,
             // Copy succeeded -- now remove the source, mimicking rename.
             ::unlinkat(eff_olddirfd, eff_oldpath, 0);
             Result = 0;
+          } else {
+            // A failed rename must not leave a partial destination behind:
+            // the caller is entitled to believe that nothing moved.
+            const int saved = errno;
+            ::unlinkat(eff_newdirfd, eff_newpath, 0);
+            errno = saved;
           }
         }
       }
diff --git i/Source/Tools/LinuxEmulation/LinuxSyscalls/Syscalls.cpp w/Source/Tools/LinuxEmulation/LinuxSyscalls/Syscalls.cpp
index 551d31a39..2e6604c9f 100644
--- i/Source/Tools/LinuxEmulation/LinuxSyscalls/Syscalls.cpp
+++ w/Source/Tools/LinuxEmulation/LinuxSyscalls/Syscalls.cpp
@@ -501,6 +501,22 @@ uint64_t ExecveHandler(FEXCore::Core::CpuStateFrame* Frame, const char* pathname
       // This is because this path is a symlink to the executing application, which is always `FEX`.
       // ex: JRE and shapez.io do this self-execution.
       Filename = SyscallHandler->Filename();
+
+      // Filename() is the guest's view of the path: FEXInterpreter strips the
+      // rootfs prefix from a program that lives inside the rootfs. Translate it
+      // exactly as an absolute `pathname` is translated above. Otherwise the ELF
+      // check below opens the stripped path on the host, where it does not exist
+      // (or is a different, native binary), returns TYPE_NONE and hence -ENOEXEC,
+      // and glibc's execvp falls back to running the ELF through /bin/sh.
+      // Chromium launches its network service and other helpers by re-executing
+      // /proc/self/exe, so a rootfs-installed Electron app crash-loops them.
+      // A program outside the rootfs has no rootfs copy, so it is left unchanged.
+      if (!Filename.empty() && Filename[0] == '/') {
+        auto Emulated = SyscallHandler->FM.GetEmulatedPath(Filename.c_str(), true);
+        if (!Emulated.empty() && FHU::Filesystem::Exists(Emulated)) {
+          Filename = std::move(Emulated);
+        }
+      }
     }
 
     Type = ELFLoader::ELFContainer::GetELFType(Filename);
