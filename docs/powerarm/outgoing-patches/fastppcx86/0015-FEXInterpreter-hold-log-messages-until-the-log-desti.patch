From b65e9ad9a5d82cfd25646d7b42b74da1e3dbb993 Mon Sep 17 00:00:00 2001
From: Jordan Bettcher <thebettcher@gmail.com>
Date: Thu, 17 Sep 2026 00:26:10 -0600
Subject: [PATCH 15/16] FEXInterpreter: hold log messages until the log
 destination is known

FEXInterpreter installs its message handler before the config is loaded,
and until Logging::Init() reads SilentLog and OutputLog that handler
writes to stderr. Everything logged while connecting to or starting
FEXServer (connection errors, "FEXServer returned empty rootfs path;
keeping configured value") therefore went to the guest's stderr whatever
the log settings were, and broke programs that capture or compare it.

Messages logged before Init() are now held in a fixed 8 KB buffer (the
allocator isn't set up yet) and replayed to the configured destination
once it is known: the server log, a file, stderr when OutputLog=stderr
is asked for, or nowhere when logging is silent (the default). Asserts
still print immediately, since the process is about to trap. If the
client can't be set up at all, the guest never runs and the held
messages are flushed to stderr as the only explanation.

With OutputLog=server and no log FD from the server, logging now goes
silent instead of falling back to stderr.

Evidence, 64K host, FEX_HOSTPAGEMODE=force, static x86-64 hello with the
server start race from the previous patch provoked: stderr went from
1639 bytes to 1139, the host page size warning alone (printed directly,
on purpose).

Found in POWERarm (byte-compared guest stderr in its test harness).
---
 .../Tools/FEXInterpreter/FEXInterpreter.cpp   | 67 +++++++++++++++++++
 1 file changed, 67 insertions(+)

diff --git a/Source/Tools/FEXInterpreter/FEXInterpreter.cpp b/Source/Tools/FEXInterpreter/FEXInterpreter.cpp
index b39ac93b7..d57cbc766 100644
--- a/Source/Tools/FEXInterpreter/FEXInterpreter.cpp
+++ b/Source/Tools/FEXInterpreter/FEXInterpreter.cpp
@@ -80,7 +80,45 @@ static int OutputFD {STDERR_FILENO};
 // Set an empty style to disable coloring when FEXServer output is e.g. piped to a file
 static bool DisableOutputColors {};
 
+// Messages logged before Init() has read SilentLog and OutputLog. Until then
+// the destination isn't known, and stderr belongs to the guest: writing there
+// breaks programs that capture or compare it (a server start race once put
+// "Couldn't connect to ...Server socket" into a compiler's stderr). Init()
+// replays these to the configured log, or drops them when logging is silent.
+// A fixed buffer: this runs before the allocator is set up.
+static bool Initialized {};
+static char EarlyMessages[8192];
+static size_t EarlyMessagesUsed {};
+
+static void HoldEarlyMessage(LogMan::DebugLevels Level, const char* Message) {
+  // Entry: level byte, message, NUL. Messages that don't fit are dropped.
+  const size_t Len = strlen(Message);
+  if (EarlyMessagesUsed + Len + 2 > sizeof(EarlyMessages)) {
+    return;
+  }
+  EarlyMessages[EarlyMessagesUsed++] = static_cast<char>(Level);
+  memcpy(EarlyMessages + EarlyMessagesUsed, Message, Len + 1);
+  EarlyMessagesUsed += Len + 1;
+}
+
+static void ReplayEarlyMessages(void (*Handler)(LogMan::DebugLevels, const char*)) {
+  for (size_t Offset = 0; Offset < EarlyMessagesUsed;) {
+    const auto Level = static_cast<LogMan::DebugLevels>(EarlyMessages[Offset]);
+    const char* Message = EarlyMessages + Offset + 1;
+    if (Handler) {
+      Handler(Level, Message);
+    }
+    Offset += strlen(Message) + 2;
+  }
+  EarlyMessagesUsed = 0;
+}
+
 void MsgHandler(LogMan::DebugLevels Level, const char* Message) {
+  if (!Initialized) {
+    HoldEarlyMessage(Level, Message);
+    return;
+  }
+
   if (SilentLog) {
     return;
   }
@@ -92,9 +130,25 @@ void MsgHandler(LogMan::DebugLevels Level, const char* Message) {
 }
 
 void AssertHandler(const char* Message) {
+  if (!Initialized) {
+    // The process is about to trap: say why, wherever it goes.
+    const auto Output = fextl::fmt::format("{} {}\n", LogMan::DebugLevelStr(LogMan::ASSERT), Message);
+    write(STDERR_FILENO, Output.c_str(), Output.size());
+    return;
+  }
   return MsgHandler(LogMan::ASSERT, Message);
 }
 
+// For a start-up failure before Init(): the guest never ran, so the held
+// messages are the only explanation the user gets.
+void FlushEarlyMessagesToStderr() {
+  Initialized = true;
+  SilentLog = false;
+  OutputFD = STDERR_FILENO;
+  DisableOutputColors = !isatty(OutputFD);
+  ReplayEarlyMessages(MsgHandler);
+}
+
 namespace FEXServer {
   static int FEXServerFD {-1};
 
@@ -132,6 +186,9 @@ void Init() {
       if (FEXServer::FEXServerFD != -1) {
         LogMan::Throw::InstallHandler(Logging::FEXServer::AssertHandler);
         LogMan::Msg::InstallHandler(Logging::FEXServer::MsgHandler);
+      } else {
+        // No server log: go silent rather than fall back to the guest's stderr.
+        LogFD = -1;
       }
     } else if (!LogFile.empty()) {
       constexpr int USER_PERMS = S_IRUSR | S_IWUSR | S_IRGRP | S_IROTH;
@@ -150,6 +207,15 @@ void Init() {
     }
   }
   DisableOutputColors = !isatty(OutputFD);
+  Initialized = true;
+
+  if (SilentLog) {
+    ReplayEarlyMessages(nullptr);
+  } else if (FEXServer::FEXServerFD != -1) {
+    ReplayEarlyMessages(FEXServer::MsgHandler);
+  } else {
+    ReplayEarlyMessages(MsgHandler);
+  }
 }
 
 } // namespace FEX::Logging
@@ -525,6 +591,7 @@ int main(int argc, char** argv, char** const envp) {
   auto SelfPath = FEX::GetSelfPath();
   if (!FEXServerClient::SetupClient(SelfPath.value_or(argv[0]))) {
     LogMan::Msg::EFmt("FEXServerClient: Failure to setup client");
+    FEX::Logging::FlushEarlyMessagesToStderr();
     return -1;
   }
 
