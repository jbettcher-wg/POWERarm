   } else {
@@ -744,6 +873,22 @@ void SignalDelegator::RestoreThreadState(FEXCore::Core::InternalThreadState* Thr
     }
 
     OldSP = *reinterpret_cast<uint64_t*>(GuestSP);
+
+    // Pop this frame's handler level and any inside it (abandoned by a jump
+    // from a nested handler back into this one).
+    auto& SignalInfo = FEX::HLE::ThreadManager::GetStateObjectFromFEXCoreThread(Thread)->SignalInfo;
+    auto* Found = SignalInfo.InnermostHandler;
+    uint32_t Inner = 0;
+    while (Found && !(Found->GuestSlot == GuestSP && Found->HostBase == OldSP)) {
+      Inner += Found->GuestSlot != 0;
+      Found = Found->Outer;
+    }
+    if (Found) {
+      Level = Found;
+      SignalInfo.InnermostHandler = Found->Outer;
+      SignalInfo.HandlerLevels -= Inner + 1;
+      Thread->CurrentFrame->SignalHandlerRefCounter -= Inner;
+    }
   }
 
   uintptr_t NewSP = OldSP;
@@ -799,52 +944,45 @@ void SignalDelegator::RestoreThreadState(FEXCore::Core::InternalThreadState* Thr
       }
     }
   }
+
+  if (Level && Level->SavedStackLen) {
+    // Put back the interrupted host stack this delivery saved. Last, since
+    // the destination may overlap the backup read above. The guest resumes on
+    // an abandoned handler's dispatcher at DeadBase; record that where that
+    // handler's own record was, above the bytes just restored.
+    const uint64_t DeadBase = Level->SavedStackAddr + Level->SavedStackLen - sizeof(ArchHelpers::Context::ContextBackup::LinkageArea);
+    auto* Outer = Level->Outer;
+    memmove(reinterpret_cast<void*>(Level->SavedStackAddr), Level + 1, Level->SavedStackLen);
+    auto* Marker = reinterpret_cast<ThreadStateObject::GuestHandlerLevel*>(DeadBase + sizeof(ArchHelpers::Context::ContextBackup));
+    *Marker = ThreadStateObject::GuestHandlerLevel {.Outer = Outer, .HostBase = DeadBase};
+    FEX::HLE::ThreadManager::GetStateObjectFromFEXCoreThread(Thread)->SignalInfo.InnermostHandler = Marker;
+  }
 }
 
