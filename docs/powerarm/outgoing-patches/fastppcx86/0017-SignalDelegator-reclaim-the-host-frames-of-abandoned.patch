+    memmove(reinterpret_cast<void*>(NewSP + sizeof(ArchHelpers::Context::ContextBackup) + sizeof(ThreadStateObject::GuestHandlerLevel)),
+            reinterpret_cast<void*>(Placement.SaveLo), SaveLen);
+  }
