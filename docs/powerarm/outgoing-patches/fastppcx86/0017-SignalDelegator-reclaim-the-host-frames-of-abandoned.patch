-ArchHelpers::Context::ContextBackup* SignalDelegator::StoreThreadState(FEXCore::Core::InternalThreadState* Thread, int Signal, void* ucontext) {
+// ---------------------------------------------------------------------------
+// Abandoned guest handlers
+// ---------------------------------------------------------------------------
+//
+// A guest handler runs on a dispatcher entered below the host frame of the
+// context it interrupted: StoreThreadState puts the ContextBackup under the
+// interrupted host SP and the dispatcher runs with SP at the backup, and
+// sigreturn puts the host SP back. A guest that leaves its handler with
+// siglongjmp/longjmp never makes that call and keeps running on the handler's
+// dispatcher, about 3 KB lower each time: a few thousand abandoned handlers
+// exhaust the host stack, or run into the guest stack when it is mapped just
+// below. (Upstream FEX has the same structure.)
+//
+// Running handlers without a nested host frame does not work on this port:
+// async signals in syscalls are delivered at the DeferredSignalRefCountGuard
+// destructor poke with the syscall's C++ frames live, and JIT blocks own a
+// stack frame, so resuming needs that host stack. Instead:
+//
+// Every delivery records a GuestHandlerLevel (ThreadManager.h) next to its
+// backup. sigreturn pops its level (found by backup address and frame slot)
+// and every level inside it. A level is abandoned when the guest SP is past
+// its frame (above it on the main stack; above it or off the altstack for an
+// altstack frame), checked at each delivery and each guest syscall (which
+// catches sigsetjmp saving the mask while the guest is still shallow), or when
+// the frame's host stack slot no longer holds the backup address (the guest
+// reused that stack before its next signal).
+//
+// When the innermost level is abandoned and the interrupted context is in JIT
+// code, the dispatcher, or C++ at a drained fault-page poke, the delivery
+// saves the interrupted context's live host stack (SP less the red zone, up to
+// the abandoned dispatcher's caller-frame area, the backup's LinkageArea),
+// builds the new backup under the innermost live level (or the thread's
+// dispatcher frame), and sigreturn copies the bytes back to the same addresses
+// so nothing is relocated. The guest then resumes on the abandoned dispatcher;
+// a marker record (GuestSlot 0) keeps that reclaimable. Other contexts, and
+// threads with a host-to-guest callback dispatcher active, nest as before.
+//
+// The rule gets one case wrong: a handler that switches to a stack at a higher
+// address and makes a syscall or takes a signal there before switching back
+// and returning is taken as abandoned; its sigreturn then finds no level and
+// falls back to the old behaviour.
+static bool IsGuestSPPastHandler(const ThreadStateObject::GuestHandlerLevel* Level, uint64_t GuestSP) {
+  if (Level->AltStackHi) {
+    if (GuestSP >= Level->AltStackLo && GuestSP < Level->AltStackHi) {
+      return GuestSP >= Level->GuestFrameHi;
+    }
+    return true;
+  }
+  return GuestSP >= Level->GuestFrameHi;
+}
+
+static bool IsHandlerAbandoned(const ThreadStateObject::GuestHandlerLevel* Level, uint64_t GuestSP) {
+  if (Level->GuestSlot == 0 || Level->KnownAbandoned || IsGuestSPPastHandler(Level, GuestSP)) {
+    return true;
+  }
+  uint64_t Word {};
+  const struct iovec Local {&Word, sizeof(Word)};
+  const struct iovec Remote {reinterpret_cast<void*>(Level->GuestSlot), sizeof(Word)};
+  if (::process_vm_readv(::getpid(), &Local, 1, &Remote, 1, 0) != sizeof(Word)) {
+    return true;
+  }
+  return Word != Level->HostBase;
+}
+
+void SignalDelegator::NoteGuestSyscall(FEXCore::Core::InternalThreadState* Thread) {
+  auto* Level = FEX::HLE::ThreadManager::GetStateObjectFromFEXCoreThread(Thread)->SignalInfo.InnermostHandler;
+  while (Level && Level->GuestSlot == 0) {
+    Level = Level->Outer;
+  }
+  if (Level && !Level->KnownAbandoned && IsGuestSPPastHandler(Level, Thread->CurrentFrame->State.gregs[FEXCore::X86State::REG_RSP])) {
+    // Only marked: the next delivery pops it.
+    Level->KnownAbandoned = true;
+  }
+}
+
+SignalDelegator::HandlerPlacement SignalDelegator::PlaceGuestHandler(FEXCore::Core::InternalThreadState* Thread, void* ucontext, bool WasInJIT) {
+  HandlerPlacement Placement {};
+#ifdef ARCHITECTURE_ppc64le
+  auto& SignalInfo = FEX::HLE::ThreadManager::GetStateObjectFromFEXCoreThread(Thread)->SignalInfo;
+  auto* Frame = Thread->CurrentFrame;
+  auto* Level = SignalInfo.InnermostHandler;
+
+  // Every nested dispatcher on this thread must be one of our levels.
+  if (!Level || Frame->SignalHandlerRefCounter != SignalInfo.HandlerLevels || Frame->ReturningStackLocation == 0) {
+    return Placement;
+  }
+
+  const uint64_t GuestSP = Frame->State.gregs[FEXCore::X86State::REG_RSP];
+  if (!IsHandlerAbandoned(Level, GuestSP)) {
+    return Placement;
+  }
+
+  const uint64_t HostPC = ArchHelpers::Context::GetPc(ucontext);
+  const uint64_t HostSP = ArchHelpers::Context::GetSp(ucontext);
+  const bool Reclaimable = WasInJIT || IsAddressInDispatcher(HostPC) || SignalInfo.DeliveringDrainedSignal;
+  const uint64_t LiveTop = Level->HostBase + sizeof(ArchHelpers::Context::ContextBackup::LinkageArea);
+  const uint64_t SaveLo = FEXCore::AlignDown(HostSP - ArchHelpers::Context::ContextBackup::RedZoneSize, 16);
+  constexpr uint64_t MaxSavedHostStack = 1024 * 1024;
+  if (!Reclaimable || HostSP > Level->HostBase || LiveTop - SaveLo > MaxSavedHostStack) {
+    return Placement;
+  }
+
+  uint32_t Popped = 0;
+  while (Level && IsHandlerAbandoned(Level, GuestSP)) {
+    Popped += Level->GuestSlot != 0;
+    Level = Level->Outer;
+  }
+  SignalInfo.InnermostHandler = Level;
+  SignalInfo.HandlerLevels -= Popped;
+  Frame->SignalHandlerRefCounter -= Popped;
+
+  Placement.BaseSP = Level ? Level->HostBase : Frame->ReturningStackLocation;
+  Placement.SaveLo = SaveLo;
+  Placement.SaveHi = LiveTop;
+#endif
+  return Placement;
+}
+
