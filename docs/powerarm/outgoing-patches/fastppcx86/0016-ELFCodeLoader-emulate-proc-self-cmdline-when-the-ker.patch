   using FDReadStringFunc = std::function<int32_t(FEXCore::Context::Context* ctx, int32_t fd, const char* pathname, int32_t flags, mode_t mode)>;
   fextl::unordered_map<fextl::string, FDReadStringFunc> FDReadCreators;
 
